# Copy to .env. Every setting maps to mosaic_contracts.wiring.Settings (MOSAIC_<FIELD>).

MOSAIC_ENV=dev
MOSAIC_DATA_DIR=./.data                 # /sovereign-data on the appliance
MOSAIC_OKF_DIR=./shared/fixtures/okf    # P2 switches to ./data/okf once the demo bundle grows
MOSAIC_POLICIES_DIR=./policies
MOSAIC_MANIFESTS_DIR=./agents/manifests

MOSAIC_DATABASE_URL=postgresql+psycopg://mosaic:mosaic@localhost:5432/mosaic
MOSAIC_REDIS_URL=redis://localhost:6379/0
MOSAIC_OLLAMA_URL=http://localhost:11434
MOSAIC_DEFAULT_CHAT_MODEL=qwen2.5:7b-instruct
MOSAIC_DEFAULT_EMBED_MODEL=nomic-embed-text

MOSAIC_GATEWAY_HOST=0.0.0.0
MOSAIC_GATEWAY_PORT=8080
MOSAIC_KNOWLEDGE_WATCH=false            # P2: republish manual edits under MOSAIC_OKF_DIR as knowledge.changed

# ---- integration switches: fake | real  (per component, or all at once)
MOSAIC_DEFAULT_MODE=fake
# MOSAIC_MODE_EVENTS=real      # P1
# MOSAIC_MODE_POLICY=real      # P1
# MOSAIC_MODE_AUDIT=real       # P1
# MOSAIC_MODE_ARTIFACTS=real   # P1
# MOSAIC_MODE_SANDBOX=real     # P1 (needs Docker + execution/images/sandbox-base built)
# MOSAIC_MODE_TOOLS=real       # P1
# MOSAIC_MODE_KNOWLEDGE=real   # P2
# MOSAIC_MODE_MEMORY=real      # P2
# MOSAIC_MODE_FIREWALL=real    # P2
# MOSAIC_MODE_MODELS=real      # P3
# MOSAIC_MODE_AGENTS=real      # P3
# MOSAIC_MODE_BROWSER=real     # P4
# MOSAIC_MODE_CONVERTERS=real  # P4
# MOSAIC_MODE_PROBE=real       # P4

# ---- P1 kernel & execution
# mock Jira used by the jira tool. "inprocess" runs it inside mosaicd (no docker needed)
MOSAIC_JIRA_URL=http://localhost:8090
# MOSAIC_EVENTS_REDIS=off                # event history is mirrored to MOSAIC_REDIS_URL when Redis answers
# MOSAIC_SANDBOX_ENDPOINT=port           # browser sandboxes: "ip" (Linux appliance) | "port" (Docker Desktop)
# MOSAIC_MCP_CONFIG=./execution/mcp.example.yaml   # MCP servers exposed as tools
# MOSAIC_KERNEL_MAX_CONCURRENT_TASKS=2
# MOSAIC_KERNEL_APPROVAL_TIMEOUT_S=1800
# MOSAIC_KERNEL_ESCALATION_TIMEOUT_S=300 # >0: ask a human before giving up on an agent that exhausted its retries
# MOSAIC_KERNEL_MAX_RESTARTS=2           # unfinished tasks are resumed from their root checkpoint after a restart
# MOSAIC_KERNEL_POLICY_WATCH_INTERVAL_S=2
# MOSAIC_KERNEL_PREEMPTION=true
# MOSAIC_KERNEL_SCHEDULES_FILE=./kernel/schedules.example.yaml   # scheduled agents (cron)

# ---- appliance only (read by docker compose via mosaicd.service)
# OLLAMA_VERSION=<pinned tag you verified>
