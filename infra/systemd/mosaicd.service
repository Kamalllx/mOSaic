# /etc/systemd/system/mosaicd.service on the appliance (P4 installs, P1 owns the process).
[Unit]
Description=mOSaic AI kernel and gateway
After=network-online.target docker.service sovereign-data.mount
Requires=docker.service sovereign-data.mount

[Service]
Type=simple
User=mosaic
WorkingDirectory=/opt/mosaic
EnvironmentFile=/opt/mosaic/.env
Environment=MOSAIC_DATA_DIR=/sovereign-data
ExecStartPre=/usr/bin/docker compose -f /opt/mosaic/infra/compose/docker-compose.yml up -d postgres redis ollama mock-jira
ExecStart=/opt/mosaic/.venv/bin/mosaicd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
