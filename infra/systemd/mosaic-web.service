# /etc/systemd/system/mosaic-web.service on the appliance (P4 packages, P2 owns apps/web).
# Build first (install.sh does it): cd /opt/mosaic/apps/web && npm ci && npm run build
# NEXT_PUBLIC_MOSAIC_URL is baked in at build time: set it in apps/web/.env.local to the node's Tailscale URL before building.
[Unit]
Description=mOSaic web console
After=network-online.target mosaicd.service
Wants=mosaicd.service

[Service]
Type=simple
User=mosaic
Group=mosaic
WorkingDirectory=/opt/mosaic/apps/web
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- -p 3000 -H 0.0.0.0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
